{
  "manifest_version": 3,
  "name": "Nitro Sniper Pro",
  "version": "1.0.4",
  "description": "Auto-claim Nitro gifts in real time",
  "permissions": ["storage"],
  "host_permissions": [
    "https://discord.com/*",
    "https://discord.com/api/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://discord.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nitro Sniper Pro"
  }
}
