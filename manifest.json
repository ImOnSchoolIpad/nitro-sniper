{
  "manifest_version": 3,
  "name": "Nitro Sniper Pro",
  "version": "1.0.4",
  "description": "Automatically claims Discord Nitro gifts the moment they drop in any server or DM.",
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": [
    "https://discord.com/*",
    "https://discordapp.com/*",
    "https://cdn.discordapp.com/*",
    "https://*.discord.com/*"
  ],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [
    {
      "matches": ["https://discord.com/*", "https://*.discord.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nitro Sniper Pro",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
